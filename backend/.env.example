# Copie este arquivo para `.env` e ajuste conforme necessário.
# Nenhuma dessas variáveis é obrigatória para rodar a V1 localmente —
# todas têm um valor padrão local funcional em app/core/config.py.

APP_NAME="Campanhas Eleitorais - Backend"
ENVIRONMENT=local
DEBUG=true

# Banco de dados. SQLite local por padrão. Para produção, use PostgreSQL
# (ex.: postgresql+psycopg://user:pass@host/db) — nenhuma mudança de
# código é necessária, ver DATABASE.md.
DATABASE_URL=sqlite:///./storage/app.db

# Armazenamento. Apenas "local" é implementado e testado ponta a ponta;
# "google_drive"/"s3" existem como adapters mas exigem credenciais reais
# (ver STORAGE_BUCKET/STORAGE_REGION e o Google OAuth abaixo).
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
BACKUP_STORAGE_PROVIDER=

# Limite de upload (bytes) e extensões aceitas.
MAX_UPLOAD_SIZE_BYTES=20971520

# Autenticação. "local" mantém o operador único sem login (V1). "google"
# ativa o login via Google OAuth (exige GOOGLE_CLIENT_ID/SECRET abaixo).
AUTH_PROVIDER=local
SECRET_KEY=change-me-in-production-local-dev-secret
SESSION_COOKIE_NAME=campanhas_session
SESSION_TTL_HOURS=12

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Fila assíncrona de processamento de documentos. "inline" (padrão) roda
# tudo de forma síncrona, igual à V1 — Redis não é necessário. "redis"
# ativa o processamento em fila (ver app/queue/), exige REDIS_URL.
QUEUE_BACKEND=inline
REDIS_URL=

# SMTP (opcional, notificações futuras)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# OCR
# Caminho do executável do Tesseract, se não estiver no PATH do sistema.
# Exemplo Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_LANGUAGE=por

LOG_LEVEL=INFO
