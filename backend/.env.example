# Copie este arquivo para `.env` e ajuste conforme necessário.
# Nenhuma dessas variáveis é obrigatória para rodar a V1 localmente —
# todas têm um valor padrão local funcional em app/core/config.py.

APP_NAME="Campanhas Eleitorais - Backend"
ENVIRONMENT=local
DEBUG=true

# Origens (separadas por vírgula) autorizadas a chamar esta API com
# credenciais (cookies de sessão). Um "*" nunca é aceito aqui — o
# navegador rejeita wildcard combinado com credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Banco de dados. SQLite local por padrão. Para produção, use PostgreSQL
# (ex.: postgresql+psycopg://user:pass@host/db) — nenhuma mudança de
# código é necessária, ver DATABASE.md.
DATABASE_URL=sqlite:///./storage/app.db

# Armazenamento. "local" (padrão) grava em storage/ no disco. "google_drive"
# usa a conta Google conectada em Configurações > Integrações (exige um
# admin logado via Google OAuth — GOOGLE_CLIENT_ID/SECRET abaixo — e o
# fluxo de conexão em GET /integrations/google-drive/connect; sem isso o
# upload falha com NOT_CONFIGURED em vez de gravar local silenciosamente).
# BACKUP_STORAGE_PROVIDER é uma cópia secundária OPCIONAL e independente:
# uma falha de backup nunca afeta o armazenamento primário do documento.
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
BACKUP_STORAGE_PROVIDER=

# Limite de upload (bytes) e extensões aceitas.
MAX_UPLOAD_SIZE_BYTES=20971520

# Autenticação. "local" mantém o operador único sem login (V1). "google"
# ativa o login via Google OAuth (exige GOOGLE_CLIENT_ID/SECRET abaixo).
AUTH_PROVIDER=local
SECRET_KEY=change-me-in-production-local-dev-secret
SESSION_COOKIE_NAME=campanhas_session
SESSION_TTL_HOURS=12

# Login por senha (PROMPT 4) funciona com qualquer AUTH_PROVIDER != local
# (o modo "local" nunca olha o cookie de sessão — ver app/core/security.py).

# Primeiro SUPER_ADMIN (PROMPT 4 — administração da plataforma/multi-tenant).
# NÃO fica salvo em lugar nenhum além do hash da senha no banco: defina só
# na primeira vez que subir o backend (`python -m app.services.admin.bootstrap`,
# ou automaticamente no entrypoint do container — ver backend/README.md) e
# depois REMOVA estas duas linhas do ambiente. Rodar de novo com um
# SUPER_ADMIN já existente não faz nada (idempotente) — nunca reseta senha.
SUPER_ADMIN_BOOTSTRAP_EMAIL=
SUPER_ADMIN_BOOTSTRAP_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Para onde /auth/google/callback redireciona o navegador após um login
# bem-sucedido.
FRONTEND_URL=http://localhost:5173
# Google Drive (GET /integrations/google-drive/connect) e Gmail, leitura
# apenas (GET /integrations/gmail/connect) reutilizam as três variáveis
# acima — nenhuma credencial extra é necessária para conectá-los.

# Fila assíncrona de processamento de documentos. "inline" (padrão) roda
# tudo de forma síncrona, igual à V1 — Redis não é necessário. "redis"
# ativa o processamento em fila (ver app/queue/), exige REDIS_URL.
QUEUE_BACKEND=inline
REDIS_URL=

# SMTP (opcional) - usado para enviar o e-mail de redefinição de senha
# (POST /auth/forgot-password). Sem isso configurado, o link de
# redefinição só fica registrado no log do servidor (a rota continua
# funcionando, só não envia o e-mail de fato).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# OCR
# Caminho do executável do Tesseract, se não estiver no PATH do sistema.
# Exemplo Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_LANGUAGE=por

LOG_LEVEL=INFO
