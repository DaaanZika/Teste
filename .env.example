# Variáveis usadas pelo docker-compose.yml / docker-compose.prod.yml.
# Copie para `.env` na raiz do projeto. Nenhum valor real de produção deve
# ser commitado — este arquivo só contém placeholders de desenvolvimento.
#
# Para rodar o backend/frontend fora do Docker, use
# backend/.env.example e frontend/.env.example em vez deste.

# --- PostgreSQL (serviço "db") ---
POSTGRES_USER=campanhas
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=campanhas
POSTGRES_PORT=5432

# --- Redis (serviço "redis", só sobe com `--profile queue`) ---
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
QUEUE_BACKEND=inline

# --- Backend ---
BACKEND_PORT=8000
SECRET_KEY=change-me-in-production-local-dev-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
STORAGE_PROVIDER=local

# --- Frontend ---
FRONTEND_PORT=5173
# URL que o NAVEGADOR usa para falar com o backend — precisa ser alcançável
# a partir da máquina do usuário, não do nome do serviço Docker.
VITE_API_BASE_URL=http://localhost:8000

# --- Google OAuth / Drive / Gmail (opcional — sistema funciona sem isso) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Armazenamento em nuvem (opcional) ---
STORAGE_BUCKET=
STORAGE_REGION=
BACKUP_STORAGE_PROVIDER=

# --- SMTP (opcional, notificações futuras) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
